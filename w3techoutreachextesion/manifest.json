{
  "icons": {
    "16": "w3tech-icons/icon16.png",
    "32": "w3tech-icons/icon32.png",
    "48": "w3tech-icons/icon48.png",
    "128": "w3tech-icons/icon128.png"
  },
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "w3tech-icons/icon16.png",
      "32": "w3tech-icons/icon32.png",
      "48": "w3tech-icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "W3Tech Outreach Ext"
  },
  "version": "12.6.1",
  "author": "BingMapsExport",
  "name": "W3Tech Outreach Ext",
  "description": "W3Tech Hunt: pick a country, states and business types — it searches Bing Maps town by town, scores the leads, lines up WhatsApp messages and saves everything to your Google Sheet. Plus the Maps Leads extractor.",
  "background": {
    "service_worker": "w3tech-sw.js"
  },
  "permissions": [
    "alarms",
    "identity",
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.bing.com/*"
      ],
      "js": [
        "leads.d3b76e5f.js"
      ],
      "run_at": "document_end",
      "css": [
        "leads.cac99bb5.css"
      ]
    },
    {
      "matches": [
        "https://www.bing.com/maps*",
        "https://bing.com/maps*"
      ],
      "js": [
        "w3tech-hunt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "key": "",
  "host_permissions": [
    "https://*.bing.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://www.w3tech.co.in/*",
    "https://w3tech.co.in/*"
  ],
  "oauth2": {
    "client_id": "1045436637864-mp9mgaioa4b3lekvskpcp1f0cae9qcvm.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.bing.com/*"
      ],
      "resources": [
        "leads.39b14202.css",
        "leads.82a6988f.css",
        "leads.3195bc2f.png",
        "leads.f3fb0fd7.png",
        "leads.81ab7c01.jpg",
        "leads.4f389fc0.png"
      ]
    }
  ],
  "options_page": "w3tech-options.html"
}